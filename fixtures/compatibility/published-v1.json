  "templateIds": [
    {
      "id": "clearline",
      "title": "Clearline",
      "description": "A one-column ATS-oriented CV with restrained blue rules and one linear reading order.",
      "author": "Alfred Mouelle",
      "registryType": "registry:block",
      "export": "ClearlineCv",
      "prop": "data",
      "exportSignature": "export function ClearlineCv({ data }: { readonly data: CvData })",
      "traits": {
        "layout": "single-column",
        "atsIntent": "ats-oriented",
        "visualTone": "classic",
        "density": "balanced",
        "photoSupport": "not-supported"
      },
      "installedPaths": [
        "@components/cv/clearline/clearline.tsx",
        "@components/cv/clearline/clearline.css",
        "@lib/cv/examples/clearline.ts",
        "~/public/cv-ui/clearline/licenses/OFL-1.1.txt"
      ],
      "sourceFiles": [
        {
          "path": "registry/clearline/clearline.tsx",
          "type": "registry:component",
          "target": "@components/cv/clearline/clearline.tsx"
        },
        {
          "path": "registry/clearline/clearline.css",
          "type": "registry:style",
          "target": "@components/cv/clearline/clearline.css"
        },
        {
          "path": "registry/clearline/example.ts",
          "type": "registry:lib",
          "target": "@lib/cv/examples/clearline.ts"
        },
        {
          "path": "registry/clearline/licenses/OFL-1.1.txt",
          "type": "registry:file",
          "target": "~/public/cv-ui/clearline/licenses/OFL-1.1.txt"
        }
      ],
      "dependencies": [],
      "devDependencies": [],
      "registryDependencies": ["https://cv-ui.alfredmouelle.com/r/cv-data.json"],
      "supportedCvDataMajors": ["1"],
      "metaSchemaVersion": "1.0",
      "license": "MIT",
      "previewPdf": "/previews/clearline/reference.pdf",
      "previewPages": ["/previews/clearline/pages/001.png", "/previews/clearline/pages/002.png"],
      "registryPath": "/r/clearline.json"
    },
    {
      "id": "signal-ledger",
