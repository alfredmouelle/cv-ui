{
  "schemaVersion": "1.0",
  "cvDataMajors": [
    {
      "major": "1",
      "schemaPath": "schemas/cv-data/v1.json",
      "fixturePaths": [
        "fixtures/cv/minimum.json",
        "fixtures/cv/en.json",
        "fixtures/cv/fr.json",
        "fixtures/cv/maximum-envelope.json",
        "fixtures/cv/wrapping.json"
      ]
    }
  ],
  "cvDataMigrations": [],
  "catalogMajors": [
    {
      "major": "1",
      "path": "public/catalog/v1/templates.json"
    }
