{
  "name": "cv-ui",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "prepare": "[ \"$(git rev-parse --show-toplevel 2>/dev/null)\" = \"$(pwd -P)\" ] && git config core.hooksPath .githooks || true",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.ts --passWithNoTests",
    "generate": "node scripts/generate.ts",
    "generate:check": "node scripts/generate.ts --check",
    "typecheck": "tsr generate && tsc --noEmit",
    "check": "biome check .",
    "check:unsafe": "biome check --write --unsafe .",
    "check:write": "biome check --write ."
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "0.10.7",
    "@tanstack/react-form": "^1.33.0",
    "@tanstack/react-router": "1.170.16",
    "@tanstack/react-router-devtools": "1.167.0",
    "@tanstack/react-start": "1.168.26",
    "@tanstack/router-plugin": "1.132.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "nitro": "3.0.260610-beta",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/devtools-vite": "0.8.0",
    "@tanstack/router-cli": "1.132.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "8.0.0",
    "vitest": "^4.1.10"
  },
  "private": true,
  "description": "cv-ui: a fully-wired app scaffolded with create-stack.",
  "createStackMetadata": {
    "initVersion": "0.13.1"
  }
}
