{
  "$id": "https://cv-ui.alfredmouelle.com/schemas/cv-ui-meta/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogOrder",
    "traits",
    "searchAliases",
    "supportedCvDataVersions",
    "license",
    "preview",
    "status"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "catalogOrder": {
      "type": "integer",
      "minimum": 0
    },
    "traits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout", "atsIntent", "visualTone", "density", "photoSupport"],
      "properties": {
        "layout": {
          "enum": ["single-column", "two-column"]
        },
        "atsIntent": {
          "enum": ["ats-oriented", "visual-first"]
        },
        "visualTone": {
          "enum": ["classic", "modern", "expressive"]
        },
        "density": {
          "enum": ["compact", "balanced", "spacious"]
        },
        "photoSupport": {
          "const": "not-supported"
        }
      }
    },
    "searchAliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "supportedCvDataVersions": {
      "const": ["1"]
    },
    "license": {
      "const": "MIT"
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pdf", "pages"],
      "properties": {
        "pdf": {
          "type": "string",
          "pattern": "^(?:/releases/[0-9a-f]{40})?/previews/[a-z][a-z0-9-]*/reference\\.pdf$"
        },
        "pages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["src", "width", "height"],
            "properties": {
              "src": {
                "type": "string",
                "pattern": "^(?:/releases/[0-9a-f]{40})?/previews/[a-z][a-z0-9-]*/pages/00[12]\\.png$"
              },
              "width": {
                "const": 1191
              },
              "height": {
                "const": 1684
              }
            }
          }
        }
      }
    },
    "status": {
      "enum": ["active", "deprecated"]
    },
    "deprecation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "date"],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "replacementTemplateId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "deprecated"
          }
        }
      },
      "then": {
        "required": ["deprecation"]
      },
      "else": {
        "not": {
          "required": ["deprecation"]
        }
      }
    }
  ]
}
